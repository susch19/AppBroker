{
  "Version": 4,
  "UniqueName": "TuyaLayout",
  "IconName": "TuyaSwitchSensor",
  "TypeNames": [
    "TuyaSwitchSensor",
    "TS011F_plug_1"
  ],

  "DashboardDeviceLayout": {
    "DashboardProperties": [
      {
        "@ref": "$['Base.json'].dashboard.id"
      },
      {
        "@ref": "$['Base.json'].dashboard.load_power"
      },
      {
        "@ref": "$['Base.json'].dashboard.current"
      },
      {
        "@ref": "$['Base.json'].dashboard.voltage"
      },
      {
        "@ref": "$['ZigbeeBase.json'].dashboard.toggle"
      }

    ]
  },
  "DetailDeviceLayout": {
    "PropertyInfos": [
      {
        "@ref": "$['Base.json'].detail.friendly_name"
      },
      {
        "@ref": "$['Base.json'].detail.id"
      },
      {
        "@ref": "$['Base.json'].detail.last_received"
      },
      {
        "@ref": "$['Base.json'].detail.link_quality"
      },
      {
        "@ref": "$['Base.json'].detail.load_power"
      },
      {
        "@ref": "$['Base.json'].detail.current"
      },
      {
        "@ref": "$['Base.json'].detail.voltage"
      },
      {
        "@ref": "$['Base.json'].detail.energy"
      }
    ],
    "HistoryProperties": [
      {
        "@ref": "$['HistoryBase.json'].load_power"
      },
      {
        "@ref": "$['HistoryBase.json'].current"
      },
      {
        "@ref": "$['HistoryBase.json'].energy"
      },
      {
        "@ref": "$['HistoryBase.json'].voltage"
      },
      {
        "@ref": "$['HistoryBase.json'].state"
      }
    ]
  }
}