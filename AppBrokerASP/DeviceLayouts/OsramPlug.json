{
  "Version": 2,
  "UniqueName": "OsramPlugLayout",
  "IconName": "TuyaSwitchSensor",
  "TypeNames": [
    "OsramPlug"
  ],
  "DashboardDeviceLayout": {
    "DashboardProperties": [
      {
        "@ref": "$['ZigbeeBase.json'].dashboard.toggle"
      },
      {
        "@ref": "$['Base.json'].dashboard.id"
      }
    ]
  },
  "DetailDeviceLayout": {
    "PropertyInfos": [
      {
        "@ref": "$['Base.json'].detail.friendly_name"
      },
      {
        "@ref": "$['Base.json'].detail.id"
      },
      {
        "@ref": "$['Base.json'].detail.contact"
      },
      {
        "@ref": "$['Base.json'].detail.last_received"
      },
      {
        "@ref": "$['Base.json'].detail.link_quality"
      }
      {
        "Name": "_",
        "Order": 0,
        "RowNr": 33,
        "DisplayName": "Status: "
      },
      {
        "@ref": "$['ZigbeeBase.json'].detail.toggle"
      }
    ],
    "HistoryProperties": [
      {
        "PropertyName": "state",
        "XAxisName": "Status",
        "UnitOfMeasurement": " ",
        "IconName": "celcius-59424",
        "BrightThemeColor": 4278241363,
        "DarkThemeColor": 4278249078,
        "ChartType": "step"
      }
    ]
  }
}